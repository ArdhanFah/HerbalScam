# ──────────────────────────────────────────────────
# Firebase Credentials, Keys & Secrets (CRITICAL)
# ──────────────────────────────────────────────────
serviceAccountKey.json
*serviceAccount*.json
*credential*.json
*secret*.json
*.pem
*.key
*.crt
*.p12

# Explicitly ignore root .json files except catalog & class names
/*.json
!data/herbal_metadata.json
!models/class_names.json

# Environment Variables
.env
.env.*
*.env

# ──────────────────────────────────────────────────
# Datasets & Heavy ML Model Weights
# ──────────────────────────────────────────────────
bukan_herbal_dataset/
*.zip
*.tar.gz
*.tgz

models/*.pt
models/*.pth
models/*.onnx
models/*.h5
models/*.tflite
models/*.bin

# Uploaded Files
uploads/*
!uploads/.gitkeep

